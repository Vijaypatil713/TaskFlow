# ====================================================================
# TASKFLOW ROOT GITIGNORE
# Ensures secrets, environments, caches, and build artifacts are safe
# ====================================================================

# Environment Variables & Secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Python virtual environments & bytecode
venv/
.venv/
backend/venv/
backend/.venv/
__pycache__/
backend/__pycache__/
*.pyc
*.pyo
*.pyd

# Node.js & Next.js build artifacts
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
*.tmp

